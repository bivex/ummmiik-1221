// Атмосферный русский инди-поп / синтивейв
define АККОРДЫ_КУПЛЕТ  = [Am, F, C, G]
define АККОРДЫ_ПРИПЕВ  = [F, G, Am, Em]
define АККОРДЫ_БРИДЖ   = [Dm, Em, F, G]

song "Огни ночного города" {
  meta {
    bpm:            118
    key:            Am
    time_signature: 4/4
    genre:          "Синти-поп"
    artist:         "Северный Луч"
    mood:           #меланхолия #ностальгия
    tags:           #инди #синтипоп #ночь #русскаямузыка
  }

  // ── Вступление: атмосферные синтезаторы и пульсирующий бас ──
  intro (4 bars) {
    chords:     [Am, F]
    synth:      "тёплый аналоговый пэд" #реверберация
    bass:       "пульсирующий восьмыми бас"
    dynamics:   piano
  }

  // ── Первый куплет ──
  verse "1" (8 bars) {
    chords:     $АККОРДЫ_КУПЛЕТ
    lyrics:     """
      Фонари мерцают сквозь холодный туман
      Город прячет в окнах бесконечный обман
      Шаг за шагом в тишине пустых площадей
      Я ищу следы давно забытых людей
    """
    vocal:      "мягкий мужской баритон" #интимно #сухой
    drums:      "электронная драм-машина 808"
    synth:      "короткий арпеджиатор"
  }

  // ── Предприпев: нарастание напряжения ──
  pre_chorus (4 bars) {
    chords:     $АККОРДЫ_БРИДЖ
    lyrics:     "И стрелки часов отмеряют рассвет..."
    vocal:      "лид-вокал с бэк-вокалом в терцию"
    snare:      "крещендо малого барабана"
    transition: build_up
  }

  // ── Взрывной припев ──
  chorus (8 bars) {
    chords:     $АККОРДЫ_ПРИПЕВ
    lyrics:     """
      Огни ночного города нас больше не ждут!
      Минуты до утра как кометы бегут!
      Пускай вокруг метель заметает мосты —
      В неоновом свете останешься ты!
    """
    vocal:      "полный голос с гармонией" #громко #пространство
    synth:      "мощный полифонический лид"
    bass:       "жирный саб-бас"
    drums:      "плотный прямой бит с открытым хэтом" #панч
    dynamics:   forte
  }

  // ── Второй куплет ──
  verse "2" (8 bars) {
    chords:     $АККОРДЫ_КУПЛЕТ
    lyrics:     """
      Мокрый асфальт отражает витрин огни
      В этом огромном мире мы снова одни
      Телефон разряжен, и вокруг тишина
      Только над крышами светит чужая луна
    """
    guitar:     "чистая электрогитара с хорусом"
  }

  // ── Соло синтезатора ──
  solo "Синтезатор" (8 bars) {
    chords:     [F, G, Em, Am]
    lead:       "ностальгическое соло в стиле 80-х" #дилэй
    drums:      "акценты на тарелках"
    transition: sweep
  }

  // ── Бридж: замедление и размышление ──
  bridge (8 bars) {
    chords:     [Dm7, Em7, Fmaj7, G]
    lyrics:     """
      Замри на миг...
      Послушай, как бьётся этот город...
    """
    piano:      "редкие аккорды пианино"
    vocal:      "шёпот с длинным эхо"
    drums:      mute
  }

  // ── Финальный припев на максимальной энергии ──
  chorus "Финал" (16 bars) {
    chords:     $АККОРДЫ_ПРИПЕВ
    lyrics:     """
      Огни ночного города нас больше не ждут!
      Минуты до утра как кометы бегут!
      В неоновом свете останешься ты!
    """
    energy:     maximum
    fx:         "белый шум, падение саба"
  }

  // ── Завершение трека ──
  outro (4 bars) {
    chords:     [Am, F, Am]
    synth:      "затухающий аналоговый аккорд"
    transition: fade_out
  }
}
