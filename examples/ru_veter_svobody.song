// Русский рок / акустическая дорожная баллада
define ГАРМОНИЯ_КУПЛЕТ = [Em, C, G, D]
define ГАРМОНИЯ_ПРИПЕВ = [C, D, Em, G]

song "Ветер дальних дорог" {
  meta {
    bpm:            84
    key:            Em
    time_signature: 4/4
    genre:          "Русский Рок"
    artist:         "Странники"
    mood:           #свобода #дорога #душа
    tags:           #рок #баллада #акустика #гитара
  }

  // ── Вступление: перебор на двенадцатиструнной гитаре ──
  intro (4 bars) {
    chords:     [Em, C, Em, D]
    guitar:     "акустический бой и перебор" #тёплый
    violin:     "одинокая протяжная скрипка"
    dynamics:   piano
  }

  // ── Первый куплет ──
  verse "1" (8 bars) {
    chords:     $ГАРМОНИЯ_КУПЛЕТ
    lyrics:     """
      Пыль степная стелется под колесом
      Солнце красит горизонт янтарным огнём
      Позади остался шум чужих городов
      Впереди — простор из несказанных слов
    """
    vocal:      "хрипловатый искренний вокал"
    bass:       "мягкий тёплый бас"
    drums:      "тарелки райд и глухой бочонок"
  }

  // ── Припев ──
  chorus (8 bars) {
    chords:     $ГАРМОНИЯ_ПРИПЕВ
    lyrics:     """
      Только ветер свободы летит за кормой!
      Разбивая сомненья, зовёт за собой!
      Если веришь дороге — она доведёт,
      Там, где сердце поёт, где рассвет настаёт!
    """
    vocal:      "экспрессивный роковый вокал" #мощь
    guitar:     "перегруженные ритм-гитары"
    drums:      "живой мощный рок-бит" #панч
    dynamics:   forte
  }

  // ── Второй куплет ──
  verse "2" (8 bars) {
    chords:     $ГАРМОНИЯ_КУПЛЕТ
    lyrics:     """
      Ночью звёзды падают прямо в ладонь
      У костра потрескивает добрый огонь
      Каждый пройденный километр и мост
      Приближает ответ на извечный вопрос
    """
    harmonica:  "блюзовая губная гармоника"
  }

  // ── Гитарное соло ──
  solo "Электрогитара" (8 bars) {
    chords:     [Am, Em, C, D]
    lead:       "певучее соло с ламповым овердрайвом"
    transition: swell
  }

  // ── Бридж ──
  bridge (8 bars) {
    chords:     [Am, Bm, C, D]
    lyrics:     """
      И когда от бессилия гаснет искра,
      Знай: рассвет неизбежно придёт до утра...
    """
    piano:      "глубокие клавишные аккорды"
    dynamics:   mezzo_piano
  }

  // ── Финальный припев ──
  chorus "Финал" (16 bars) {
    chords:     $ГАРМОНИЯ_ПРИПЕВ
    lyrics:     """
      Только ветер свободы летит за кормой!
      Разбивая сомненья, зовёт за собой!
    """
    guitar:     "две соло-гитары в унисон"
    energy:     maximum
  }

  // ── Кода ──
  outro (4 bars) {
    chords:     [Em, C, Em]
    guitar:     "финальный аккорд с открытыми струнами"
    transition: fade_out
  }
}
