// Сучасний український інді-фольк / електро-поп
define АКОРДИ_КУПЛЕТ = [Dm, Bb, F, C]
define АКОРДИ_ПРИСПІВ = [Bb, C, Dm, Am]

song "Зорі над Дніпром" {
  meta {
    bpm:            122
    key:            Dm
    time_signature: 4/4
    genre:          "Інді-фольк"
    artist:         "Дніпровські Хвилі"
    mood:           #сила #натхнення #краса
    tags:           #українськамузика #інді #фольк #бандура #хіт
  }

  // ── Вступ: переливчаста бандура та легка сопілка ──
  intro (4 bars) {
    chords:     [Dm, Bb]
    bandura:    "ніжний перебір струн бандури" #реверберація
    sopilka:    "повітряний мелізматичний наспів"
    dynamics:   piano
  }

  // ── Перший куплет ──
  verse "1" (8 bars) {
    chords:     $АКОРДИ_КУПЛЕТ
    lyrics:     """
      Туман лягає сивий на крутий пологий берег
      І шепче вітер у саду забутий давній шерех
      Тече ріка крізь тисячі світанків і століть
      А в небі перша зіронька самотньо мерехтить
    """
    vocal:      "глибокий жіночий спів" #щирий #теплий
    percussion: "шаманський бубон та легкі тарілки"
    bass:       "глибокий теплий суб-бас"
  }

  // ── Передприспів: розгін ритму ──
  pre_chorus (4 bars) {
    chords:     [Gm, Am, Bb, C]
    lyrics:     "І прокидається земля від довгого чекання..."
    sopilka:    "виразне crescendo"
    drums:      "наростання малого барабана"
    transition: build_up
  }

  // ── Потужний приспів ──
  chorus (8 bars) {
    chords:     $АКОРДИ_ПРИСПІВ
    lyrics:     """
      Засвітять зорі над Дніпром, розсіють темну ніч!
      І стане світло навкруги мільйонам наших віч!
      Допоки б'ється серце тут і лине вільний спів —
      Ніхто не зломить глибини батьківських берегів!
    """
    vocal:      "двоголосся, народний белт" #потужно #широко
    bandura:    "акцентований ритмічний чіс"
    drums:      "потужний сучасний прямий біт" #punchy
    synth:      "широкий фоновий синтезатор"
    dynamics:   forte
  }

  // ── Другий куплет ──
  verse "2" (8 bars) {
    chords:     $АКОРДИ_КУПЛЕТ
    lyrics:     """
      Роса сріблиться у траві, мов розсипи перлин
      Злітає пісня солов'я до зоряних вершин
      І кожен крок по цій землі відлунює в душі
      Пиши історію свою, за обрій поспіши
    """
    acoustic:   "ритмічна акустична гітара"
  }

  // ── Соло традиційних інструментів ──
  solo "Сопілка та Бандура" (8 bars) {
    chords:     [Bb, C, Dm, F]
    lead:       "віртуозний діалог сопілки з пасажами бандури"
    transition: sweep
  }

  // ── Бридж: медитативна тиша перед кульмінацією ──
  bridge (8 bars) {
    chords:     [Gm7, Am7, Bbmaj7, C]
    lyrics:     """
      Слухай тишу...
      У ній народжується новий день...
    """
    vocal:      "акапельний спів з відлунням"
    drums:      mute
    dynamics:   pianissimo
  }

  // ── Фінальний кульмінаційний приспів ──
  chorus "Фінал" (16 bars) {
    chords:     $АКОРДИ_ПРИСПІВ
    lyrics:     """
      Засвітять зорі над Дніпром, розсіють темну ніч!
      І стане світло навкруги мільйонам наших віч!
      Ніхто не зломить глибини батьківських берегів!
    """
    energy:     maximum
    fx:         "підйом частот, вибуховий краш"
  }

  // ── Кода / закінчення ──
  outro (4 bars) {
    chords:     [Dm, Bb, Dm]
    bandura:    "затихаюче арпеджіо бандури"
    transition: fade_out
  }
}
