// Український інді-рок / пост-панк
define АКОРДИ_ОСНОВА = [Em, C, Am, D]
define АКОРДИ_ПРИСПІВ = [C, D, Em, G]

song "Місто спить" {
  meta {
    bpm:            130
    key:            Em
    time_signature: 4/4
    genre:          "Інді-рок"
    artist:         "Нічні Тіні"
    mood:           #драйв #постпанк #ніч
    tags:           #українськийрок #інді #постпанк #київ
  }

  // ── Вступ: енергійний бас з хорусом та ритмічні барабани ──
  intro (8 bars) {
    chords:     [Em, C]
    bass:       "холодний пост-панковий бас із хорусом" #драйв
    drums:      "моторний ритм із відкритим хай-хетом"
    guitar:     "дзвінкий ритмічний чес на високих ладах"
  }

  // ── Перший куплет ──
  verse "1" (8 bars) {
    chords:     $АКОРДИ_ОСНОВА
    lyrics:     """
      Порожні вулиці й розбиті ліхтарі
      Холодний подих підступає на зорі
      Маршрут знайомий до найменших дрібниць
      Серед мільйонів незнайомих облич
    """
    vocal:      "монотонний фірмовий вокал" #хорус
    synth:      "холодна струнна підкладка"
  }

  // ── Передприспів ──
  pre_chorus (4 bars) {
    chords:     [Am, Bm, C, D]
    lyrics:     "Але під попелом ще жевріє вогонь..."
    snare:      "прискорення ритму"
    transition: build_up
  }

  // ── Приспів ──
  chorus (8 bars) {
    chords:     $АКОРДИ_ПРИСПІВ
    lyrics:     """
      Коли це місто спить, ми запалимо ніч!
      Крізь бетонні стіни зробимо крок навстріч!
      І хай холодний вітер б'є у вікно —
      Ми знайдемо світло, що згасло давно!
    """
    vocal:      "експресивний емоційний крик" #дисторшн
    guitar:     "перевантажений фузз"
    drums:      "щільний динамічний приспівний біт"
    dynamics:   forte
  }

  // ── Другий куплет ──
  verse "2" (8 bars) {
    chords:     $АКОРДИ_ОСНОВА
    lyrics:     """
      На мокрих шибках залишаються сліди
      І течія несе у вирій холоди
      Та кожен удар пульсу каже: живи!
      Не зупиняйся посеред трави!
    """
  }

  // ── Гітарне соло ──
  solo "Гітара" (8 bars) {
    chords:     [Em, C, Am, B7]
    lead:       "швидке мелодійне соло з ділеєм та тремоло"
    transition: sweep
  }

  // ── Бридж ──
  bridge (8 bars) {
    chords:     [Cmaj7, D, Em, G]
    lyrics:     """
      Тільки кроки в темряві...
      Тільки тиша й ми...
    """
    bass:       "одинока партія басу"
    vocal:      "пошепки"
  }

  // ── Фінальний приспів ──
  chorus "Фінал" (16 bars) {
    chords:     $АКОРДИ_ПРИСПІВ
    lyrics:     """
      Коли це місто спить, ми запалимо ніч!
      Крізь бетонні стіни зробимо крок навстріч!
      Ми знайдемо світло, що згасло давно!
    """
    energy:     maximum
  }

  // ── Фінал ──
  outro (8 bars) {
    chords:     [Em, C, Em]
    guitar:     "зворотний зв'язок (feedback) та затухання"
    transition: fade_out
  }
}
